# ==============================================================================
# SCHOLARPAY ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Safe to expose to browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stellar Network & RPC Endpoints
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Deployed Soroban Smart Contract Address on Stellar TESTNET
NEXT_PUBLIC_SOROBAN_CONTRACT_ID="CAQWR6A4JQIPR5IVPIF47KB2TJQJYFC6IDXXUZ2DRMOFFE4PDONQ7RCQ"

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_actual_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN="https://your_key@o0.ingest.sentry.io/0"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER expose to browser or commit to repository)
# ------------------------------------------------------------------------------
# Database URL (SQLite for local dev, PostgreSQL for cloud deployment)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/scholarpay?sslmode=require"

# JWT Secret Key (Minimum 32 characters)
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"

# Sentry Backend DSN (Optional)
SENTRY_DSN="https://your_key@o0.ingest.sentry.io/0"
